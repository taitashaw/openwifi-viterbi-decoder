# Vivado project-generated directories (regenerated by the numbered .tcl scripts)
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
.Xil/
ip_pack_proj/
ip_repo/

# Vivado logs, journals, waveform configs/process state
*.jou
*.log
*.str
*.pb
*.wdb
webtalk*
hs_err_pid*.log
vivado_pid*.str

# xsim simulation build output (regenerated from the .vhd sources)
xsim.dir/

# Python
__pycache__/
*.pyc

# Unrelated local tool state, not project source
.claude-flow/
ruvector.db

# Vivado project/IP XML (regenerated by 07_block_design_axis.tcl + package_viterbi_ip.tcl)
*.xpr

# Vitis workspace (platform/BSP/app build output, regenerated by create_platform.py + build_app.py)
vitis_ws/

# Exported hardware platform (regenerated by 16_export_xsa.tcl)
*.xsa
